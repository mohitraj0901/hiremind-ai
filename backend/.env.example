# ============================================================
# HireMind AI — Backend Environment Configuration
# Copy this file to `.env` and fill in real values.
# NEVER commit the actual `.env` file.
# ============================================================

# --- App ---
APP_NAME="HireMind AI API"
APP_VERSION="0.1.0"
ENVIRONMENT=development          # development | staging | production
DEBUG=true
LOG_LEVEL=INFO                   # DEBUG | INFO | WARNING | ERROR

# --- API ---
API_V1_PREFIX=/api/v1
# Comma-separated list of allowed frontend origins for CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- MongoDB Atlas ---
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster-url>/?retryWrites=true&w=majority
MONGODB_DB_NAME=hiremind_ai

# --- JWT (used starting Module 2, declared now so config.py is stable) ---
JWT_SECRET_KEY=change-me-to-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Gemini API (used starting Module 5) ---
GEMINI_API_KEY=

# --- Deepgram (used starting Module 6) ---
DEEPGRAM_API_KEY=

# --- Judge0 (used starting Module 9) ---
JUDGE0_API_URL=https://judge0-ce.p.rapidapi.com
JUDGE0_API_KEY=
